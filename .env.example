# Multiflash MCP server configuration.
# Copy to .env and adjust for your local install.

# Path to the Multiflash 64-bit PVT DLL.
# Windows default:
MULTIFLASH_DLL_PATH=C:\program files\KBC\Multiflash 7.5\x64\mfpvt64.dll

# Path to the Multiflash install directory (contains the components databank).
MULTIFLASH_DB_PATH=C:\program files\KBC\Multiflash 7.5
